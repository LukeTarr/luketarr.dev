---
import { socials } from '../data/site';

interface Props {
	/** `icons`: round icon buttons. `labels`: icon + name, for the hero. */
	variant?: 'icons' | 'labels';
	class?: string;
}

const { variant = 'icons', class: className } = Astro.props;
---

<ul
	class:list={[
		'flex flex-wrap items-center',
		variant === 'icons' ? 'gap-2' : 'gap-x-6 gap-y-3',
		className,
	]}
>
	{socials.map(({ label, href, ariaLabel, viewBox, path }) => (
		<li>
			<a
				href={href}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={ariaLabel}
				class:list={[
					'group flex items-center transition-colors',
					variant === 'icons'
						? 'h-10 w-10 justify-center rounded-full border border-ink/10 text-ink/70 hover:-translate-y-0.5 hover:border-accent/40 hover:text-accent motion-safe:transition-all'
						: 'gap-2 text-ink/70 hover:text-accent',
				]}
			>
				<svg viewBox={viewBox} class="h-[18px] w-[18px]" fill="currentColor" aria-hidden="true">
					<path d={path} />
				</svg>
				{variant === 'labels' && (
					<span class="font-mono text-sm">
						{label.toLowerCase()}{' '}
						<span class="inline-block transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5">
							↗
						</span>
					</span>
				)}
			</a>
		</li>
	))}
</ul>
